{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentTrace",
  "version": "0.4.0",
  "identifier": "com.agenttrace.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd web && pnpm dev",
    "beforeBuildCommand": "cd web && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentTrace",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss: http://localhost:18765",
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist",
      "exceptionDomain": "localhost"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFODNBM0QyQzgyQjE1MzMKUldUU3F1RG1JUEV1N1R1MnNHbE1yd0VENzE2T1BrMVRaU1lLRE1WcnhqdFBBUHM4eG1Lak5mUFUK",
      "endpoints": [
        "https://github.com/agenttrace/agent-trace/releases/latest/download/latest.json"
      ]
    }
  }
}
